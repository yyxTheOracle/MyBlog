{
  "name": "hexo-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "hexo generate",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "prepare": "husky",
    "server": "hexo server",
    "images:prepare": "node scripts/prepare-images.cjs",
    "images:check": "node scripts/prepare-images.cjs --check",
    "images:preview": "node scripts/prepare-images.cjs --preview",
    "prebuild": "npm run images:prepare",
    "predeploy": "npm run build && npm run images:check",
    "preserver": "npm run images:preview"
  },
  "hexo": {
    "version": "6.0.0"
  },
  "dependencies": {
    "ejs": "^3.1.8",
    "hexo": "^6.0.0",
    "hexo-abbrlink": "^2.2.1",
    "hexo-admin": "^2.3.0",
    "hexo-baidu-url-submit": "^0.0.6",
    "hexo-deployer-git": "^3.0.0",
    "hexo-filter-mermaid-diagrams": "^1.0.5",
    "hexo-generator-archive": "^1.0.0",
    "hexo-generator-baidu-sitemap": "^0.1.9",
    "hexo-generator-category": "^1.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^2.0.0",
    "hexo-generator-json-content": "^4.2.3",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^1.0.0",
    "hexo-helper-live2d": "^3.1.1",
    "hexo-math": "^4.0.0",
    "hexo-renderer-ejs": "^1.0.0",
    "hexo-renderer-marked": "^4.0.0",
    "hexo-renderer-stylus": "^2.0.0",
    "hexo-server": "^2.0.0",
    "hexo-wordcount": "^6.0.1",
    "live2d-widget-model-hibiki": "^1.0.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "husky": "^9.1.7",
    "sharp": "0.35.5"
  }
}
