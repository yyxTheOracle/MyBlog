<% if (page.current > 1) { %>
  <%- partial('_partial/list', {posts: page.posts, title: '更多文章', paginated: true}) %>
<% } else {
  const posts = site.posts.sort('date', -1).toArray();
  const featured = ['12e2a8de', 'db62fe35', '2a798ab5'].map(id => posts.find(post => String(post.abbrlink) === id)).filter(Boolean);
  const project = posts.find(post => String(post.abbrlink) === '2733f88e');
%>
<div class="home-shell">
  <section class="home-intro" aria-labelledby="home-title">
    <div><p class="intro-greeting">你好，我是 Victor Ye</p><%- partial('_partial/hero-title') %><p class="intro-description">前后端开发、AI Coding、踩坑复盘，偶尔写点别的。</p><div class="intro-links"><a class="primary-link" href="#latest">阅读文章 <span aria-hidden="true">↘</span></a><a href="https://github.com/yyxTheOracle" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div></div>
    <figure class="profile-portrait"><img src="/img/avatar.jpg" width="260" height="260" alt="Victor 的潜水照片"><figcaption><span>Code Clarity</span> &gt; <span>Code Brevity</span></figcaption></figure>
  </section>
  <section class="featured-section" aria-labelledby="featured-title">
    <div class="section-heading"><h2 id="featured-title">精选文章</h2></div>
    <div class="featured-grid">
    <% featured.forEach((post, index) => { %>
      <% /* 整张卡片使用一个原生链接，保留键盘、右键和新标签页打开行为。 */ %>
      <a class="featured-post <%= index === 0 ? 'featured-main' : '' %>" href="<%= url_for(post.path) %>" aria-label="<%= post.title %>">
        <p class="post-topic"><%= post.tags.toArray().map(tag => tag.name).slice(0, 2).join(' / ') %></p>
        <h3><%= post.title %></h3>
        <% /* 摘录保留正文原话，只移除“背景”等小标题，避免它们混入卡片摘要。 */ %>
        <p class="post-summary"><%= truncate(strip_html((post.excerpt || '').replace(/<h([1-6])\b[^>]*>[\s\S]*?<\/h\1>/gi, '')).replace(/\s+/g, ' ').trim(), {length: index === 0 ? 110 : 65}) %></p>
        <div class="post-meta"><time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><%= date(post.date,'YYYY.MM.DD') %></time><span>预计阅读 <%= min2read(post.content) %> 分钟</span><span class="read-link" aria-hidden="true">↗</span></div>
      </a>
    <% }); %>
    </div>
  </section>
  <% if (project) { %>
  <section class="project-section" aria-labelledby="project-title">
    <figure class="project-image project-demo">
      <video id="project-demo" width="2560" height="1550" muted loop playsinline controls preload="none" poster="https://s3.bmp.ovh/2026/11/04/tHgXhaGP.jpg" aria-label="天工批量填写好评回复的操作演示">
        <source src="/assets/electron-tiangong/reply-demo.mp4" type="video/mp4">
        <a href="/assets/electron-tiangong/reply-demo.mp4">查看操作演示</a>
      </video>
      <button id="project-demo-toggle" type="button" aria-controls="project-demo" hidden>播放演示</button>
    </figure>
    <a class="project-copy" href="<%= url_for(project.path) %>" aria-labelledby="project-title"><p class="post-topic">项目手记 · Electron / React / AI Coding</p><h2 id="project-title">给运营支持团队做提效工具，<br>做着做着，这个团队没了</h2><p>当效率被提到了极致，最先被优化的，恰恰是原本需要被减负的人</p><span class="text-link" aria-hidden="true">↗</span></a>
  </section>
  <script defer src="/js/project-video.js"></script>
  <% } %>
  <section id="latest" class="latest-section" aria-labelledby="latest-title">
    <div class="section-heading"><h2 id="latest-title">最近更新</h2><a href="/archives/">全部 <%= posts.length %> 篇 ↗</a></div>
    <div class="post-list"><% posts.slice(0,6).forEach(post => { %><%- partial('_partial/post-row', {post}) %><% }); %></div>
  </section>
</div>
<% } %>
