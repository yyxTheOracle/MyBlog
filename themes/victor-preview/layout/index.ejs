<% if (page.current > 1) { %>
  <%- partial('_partial/list', {posts: page.posts, title: '更多文章', paginated: true}) %>
<% } else {
  const posts = site.posts.sort('date', -1).toArray();
  const featured = ['310ea7d9', 'db62fe35'].map(id => posts.find(post => String(post.abbrlink) === id)).filter(Boolean);
  const project = posts.find(post => String(post.abbrlink) === '2733f88e');
%>
<div class="home-shell">
  <section class="home-intro" aria-labelledby="home-title">
    <div class="home-intro-copy"><p class="intro-greeting">你好，我是 Victor Ye</p><%- partial('_partial/hero-title') %><p class="intro-description">前后端开发、AI Coding、踩坑复盘，偶尔写点别的。</p><div class="intro-links"><a class="primary-link" href="#latest">阅读文章 <span aria-hidden="true">↘</span></a><nav class="social-inline-group" aria-label="社交主页"><a class="social-link" href="https://github.com/yyxTheOracle" target="_blank" rel="noopener noreferrer" aria-label="访问 Victor 的 GitHub 主页（在新标签页打开）"><svg class="social-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg><span>GitHub</span></a><a class="social-link" href="https://www.xiaohongshu.com/user/profile/5bffbf6a51783a6fd2c762bb" target="_blank" rel="noopener noreferrer" aria-label="访问 Victor 的小红书主页（在新标签页打开）"><svg class="social-icon social-icon-xhs" width="16" height="16" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.6" aria-hidden="true" focusable="false"><rect width="37" height="37" x="5.5" y="5.5" fill="none" stroke-linecap="round" stroke-linejoin="round" rx="4" ry="4"/><path fill="none" stroke-linecap="round" stroke-linejoin="round" d="M32.254 19.374v9.252m-5.781-7.776v7.776M24.95 20.85h3.047m-4.038 7.776h4.803m1.599-7.776h4.13c.49 0 .885.396.885.885v2.696"/><path fill="none" stroke-linecap="round" stroke-linejoin="round" d="M29.815 24.43h7.194a.99.99 0 0 1 .99.991v2.214a.99.99 0 0 1-.99.99h-1.83m1.859-7.308l.962-.89m-16.316 8.199h-2.118m-2.378-6.655l.697 5.07m-7.202-5.07L10 27.3m3.922-7.926v7.892c0 .75-.609 1.36-1.36 1.36H12.2m9.484-9.252l-1.367 3.253h1.866l-1.367 3.252h1.865"/></svg><span>小红书</span></a><a class="social-link" href="https://www.instagram.com/victorye0106/" target="_blank" rel="noopener noreferrer" aria-label="访问 Victor 的 Instagram 主页（在新标签页打开）"><svg class="social-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg><span>Instagram</span></a></nav></div></div>
    <figure class="profile-portrait" data-avatar-dive data-diver-src="/img/avatar-diver-v1.webp">
      <% /* 原照保留为默认画面；分层资源准备好后才开放拖动，加载失败仍能正常看头像。 */ %>
      <div class="avatar-dive-anchor">
      <button class="avatar-dive-trigger" data-avatar-dive-trigger type="button" disabled aria-label="拖动潜水员，留下气泡。也可点按或按回车体验，按 Escape 结束。" title="拖动或点按，和我一起潜水">
        <img class="avatar-dive-seabed" data-avatar-seabed src="/img/avatar-seabed-v1.webp" width="260" height="260" alt="" aria-hidden="true" loading="lazy" decoding="async">
        <img data-avatar-photo src="/img/avatar.jpg" width="260" height="260" alt="Victor 的潜水照片" draggable="false">
      </button>
      <span class="avatar-dive-hint" aria-hidden="true"><span>试着把我拖出来</span><svg viewBox="0 0 32 20" fill="none"><path d="M1 15Q14 2 30 9M25 4L30 9L24 12.5"/></svg></span>
      </div>
      <figcaption><span>Code Clarity</span> &gt; <span>Code Brevity</span></figcaption>
    </figure>
  </section>
  <section class="featured-section" aria-labelledby="featured-title">
    <div class="section-heading"><h2 id="featured-title">精选文章</h2></div>
    <div class="featured-grid">
    <% if (project) { %>
      <article class="featured-post featured-main">
        <% /* 演示独立于文章链接，原生控件仅作为脚本不可用时的兜底。 */ %>
        <figure class="project-demo">
          <video id="project-demo" width="2560" height="1550" muted loop playsinline controls preload="none" poster="/assets/electron-tiangong/reply-demo-poster.jpg" aria-label="天工批量填写好评回复的操作演示">
            <source src="/assets/electron-tiangong/reply-demo.mp4" type="video/mp4">
            <a href="/assets/electron-tiangong/reply-demo.mp4">查看操作演示</a>
          </video>
        </figure>
        <a class="featured-main-copy" href="<%= url_for(project.path) %>" aria-labelledby="project-title">
          <p class="post-topic">Electron / React / AI Coding</p>
          <h3 id="project-title">给运营支持团队做提效工具，做着做着，这个团队没了</h3>
          <p class="post-summary">当效率被提到了极致，最先被优化的，恰恰是原本需要被减负的人。</p>
          <div class="post-meta"><time datetime="<%= date(project.date,'YYYY-MM-DD') %>"><%= date(project.date,'YYYY.MM.DD') %></time><span>约 <%= wordcount(project.content) %> 字</span><span>预计阅读 <%= min2read(project.content) %> 分钟</span><span class="read-link" aria-hidden="true">↗</span></div>
        </a>
      </article>
    <% } %>
    <% featured.forEach(post => {
      const isEssay = String(post.abbrlink) === '310ea7d9';
    %>
      <% /* 整张卡片使用一个原生链接，保留键盘、右键和新标签页打开行为。 */ %>
      <a class="featured-post<%= isEssay ? ' featured-essay' : '' %>" href="<%= url_for(post.path) %>" aria-label="<%= post.title %>">
        <p class="post-topic"><%= post.tags.toArray().map(tag => tag.name).slice(0, 2).join(' / ') %></p>
        <h3><%= post.title %></h3>
        <% /* 随笔首图回应导语里的“这张照片”，其余精选保持原有排版。 */ %>
        <% if (isEssay) { %><div class="featured-essay-content"><% } %>
        <% /* 完整展示文章已有导语；只移除小标题和 HTML，不按字数截断或改写。 */ %>
        <p class="post-summary"><%= strip_html((post.excerpt || '').replace(/<h([1-6])\b[^>]*>[\s\S]*?<\/h\1>/gi, '')).replace(/\s+/g, ' ').trim() %></p>
        <% if (isEssay) { %>
          <img class="featured-essay-photo" src="/assets/article-images/ce0a20fc73f646a2b7a1-480.webp" width="480" height="360" loading="lazy" decoding="async" alt="2016 年进才中学二十周年校庆，中央大楼前的舞台与观众">
        </div><% } %>
        <div class="post-meta"><time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><%= date(post.date,'YYYY.MM.DD') %></time><span>约 <%= wordcount(post.content) %> 字</span><span>预计阅读 <%= min2read(post.content) %> 分钟</span><span class="read-link" aria-hidden="true">↗</span></div>
      </a>
    <% }); %>
    </div>
  </section>
  <% if (project) { %>
  <script defer src="/js/project-video.js"></script>
  <% } %>
  <section id="latest" class="latest-section" aria-labelledby="latest-title">
    <div class="section-heading"><h2 id="latest-title">最近更新</h2><a href="/archives/">全部 <%= posts.length %> 篇 ↗</a></div>
    <div class="cursor-list">
      <% /* 共享底色只跟随当前鼠标或键盘焦点；文章仍是普通链接。 */ %>
      <div class="cursor-marker" aria-hidden="true"></div>
      <% posts.slice(0,6).forEach(post => { %>
      <a class="cursor-row" href="<%= url_for(post.path) %>" aria-label="<%= post.title %>">
        <div class="cursor-copy"><h3><%= post.title %></h3><p class="cursor-meta"><time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><%= date(post.date,'YYYY.MM.DD') %></time><span><%= post.tags.toArray().map(tag => tag.name).join(' · ') %></span></p></div>
        <span class="cursor-open" aria-hidden="true"><span>阅读全文</span><svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      </a>
      <% }); %>
    </div>
  </section>
</div>
<% } %>
