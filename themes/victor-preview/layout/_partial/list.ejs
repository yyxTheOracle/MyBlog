<div class="list-shell"><header class="list-heading"><p class="post-topic">Victor 的自留地</p><h1><%= title %></h1></header><div class="post-list"><% posts.sort('date',-1).each(post => { %><%- partial('post-row', {post}) %><% }); %></div><% if (paginated && page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text:'上一页',next_text:'下一页'}) %></nav><% } %></div>
