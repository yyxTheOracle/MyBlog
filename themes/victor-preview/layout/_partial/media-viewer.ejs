<dialog id="media-viewer" aria-labelledby="media-viewer-title">
  <header class="media-viewer-toolbar">
    <h2 id="media-viewer-title">查看大图</h2>
    <div class="media-viewer-actions">
      <button type="button" data-media-zoom="out" aria-label="缩小图片">缩小</button>
      <button type="button" data-media-zoom="fit">适应窗口</button>
      <button type="button" data-media-zoom="in" aria-label="放大图片">放大</button>
      <button type="button" data-media-close autofocus aria-label="关闭大图">关闭</button>
    </div>
  </header>
  <div class="media-viewer-viewport" tabindex="0" aria-label="图片查看区，可滚动查看放大后的内容">
    <div class="media-viewer-canvas"></div>
  </div>
  <p class="media-viewer-caption" aria-live="polite"></p>
</dialog>
