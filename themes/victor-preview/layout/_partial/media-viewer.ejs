<dialog id="media-viewer" aria-label="图片预览">
  <header class="media-viewer-header">
    <span class="media-viewer-counter" aria-live="polite" aria-atomic="true"></span>
    <button type="button" class="media-viewer-close" data-media-close aria-label="关闭大图">
      <svg class="media-viewer-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M18 6L6 18M6 6l12 12"/></svg>
    </button>
  </header>
  <button type="button" class="media-viewer-step prev" data-media-step="-1" aria-label="上一张图片" hidden>
    <svg class="media-viewer-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button type="button" class="media-viewer-step next" data-media-step="1" aria-label="下一张图片" hidden>
    <svg class="media-viewer-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <div class="media-viewer-status" role="status" aria-live="polite"></div>
  <div class="media-viewer-viewport" tabindex="0" aria-label="图片查看区，双击或按 Z 缩放，左右键切换，点击空白处关闭">
    <div class="media-viewer-canvas">
      <div class="media-viewer-frame"></div>
    </div>
  </div>
  <footer class="media-viewer-footer">
    <p class="media-viewer-caption" aria-live="polite"></p>
    <div class="media-viewer-filmstrip" role="group" aria-label="快速切换本文图片" hidden></div>
  </footer>
</dialog>
