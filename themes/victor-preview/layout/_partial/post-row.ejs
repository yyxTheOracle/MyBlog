<a class="post-row" href="<%= url_for(post.path) %>" aria-label="<%= post.title %>"><time datetime="<%= date(post.date,'YYYY-MM-DD') %>"><%= date(post.date,'YYYY.MM.DD') %></time><div><h3><%= post.title %></h3><p><%= post.tags.toArray().map(tag => tag.name).join(' · ') %></p></div><span aria-hidden="true">↗</span></a>
