<% const tocContent = toc(page.content, {list_number:false}); %>
<div class="reading-layout">
  <article class="reading-article" id="post-<%= page.slug %>">
    <header class="post-header"><a class="back-link" href="/archives/">← 所有文章</a><div class="article-tags"><% page.tags.each(tag => { %><a href="<%= url_for(tag.path) %>"><%= tag.name %></a><% }); %></div><h1><%= page.title %></h1><div class="post-meta"><span>Victor Ye</span><time datetime="<%= date(page.date,'YYYY-MM-DD') %>"><%= date(page.date,'YYYY.MM.DD') %></time><span>约 <%= wordcount(page.content) %> 字</span><span>预计阅读 <%= min2read(page.content) %> 分钟</span><% if (theme.waline && theme.waline.enable) { %><span>阅读量 <span class="waline-pageview-count" data-path="/<%= page.path %>" aria-live="polite"><span class="pageview-loading" role="status" aria-label="阅读量加载中"></span></span></span><% } %></div></header>
    <% if (theme.waline && theme.waline.enable) { %>
    <script>
      // 在 CDN 资源加载前开始计时；成功读数会替换 spinner，超时不覆盖已显示的数字。
      setTimeout(() => {
        const count = document.querySelector('.waline-pageview-count');
        if (count && count.querySelector('.pageview-loading')) count.textContent = '—';
      }, 15000);
    </script>
    <% } %>
    <% if (tocContent && !page.no_toc) { %><details class="mobile-toc"><summary>本文目录</summary><nav aria-label="手机文章目录"><%- tocContent %></nav></details><% } %>
    <div id="article-content" class="article-prose"><%- page.content %></div>
    <% if (!page.no_declare) { %><aside class="article-license"><p>本文由 Victor Ye 撰写，采用 <a rel="license" href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a> 许可。转载请注明出处。</p></aside><% } %>
    <nav class="article-neighbors" aria-label="相邻文章"><% if (page.prev) { %><a href="<%= url_for(page.prev.path) %>"><span>上一篇</span><strong><%= page.prev.title %></strong></a><% } %><% if (page.next) { %><a href="<%= url_for(page.next.path) %>"><span>下一篇</span><strong><%= page.next.title %></strong></a><% } %></nav>
    <%- partial('_partial/waline', {post: page}) %>
  </article>
  <% if (tocContent && !page.no_toc) { %><aside class="desktop-toc"><nav aria-label="文章目录"><h2>本文目录</h2><%- tocContent %></nav></aside><% } %>
</div>
<% /* 回顶入口独立于目录，无目录文章与手机端也能使用。 */ %>
<button type="button" class="back-top">
  <span class="back-top-icon" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 19V5m-6 6 6-6 6 6"></path></svg></span>
  <span>回到顶部</span>
</button>
<% if (tocContent && !page.no_toc) { %>
<button type="button" class="mobile-toc-trigger" aria-haspopup="dialog" aria-controls="mobile-toc-dialog">目录</button>
<dialog id="mobile-toc-dialog" aria-labelledby="mobile-toc-title">
  <div class="mobile-toc-heading"><h2 id="mobile-toc-title">本文目录</h2><button type="button" class="plain-button" data-close-toc aria-label="关闭目录">关闭</button></div>
</dialog>
<% } %>
<%- partial('_partial/media-viewer') %>
<% if (page.mathjax) { %><script>window.MathJax={tex:{inlineMath:[['$','$'],['\\(','\\)']]},options:{skipHtmlTags:['script','noscript','style','textarea','pre','code']}};</script><script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script><% } %>
