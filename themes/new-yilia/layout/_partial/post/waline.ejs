<% const showComments = theme.waline.enable && !post.no_comments; %>
<% if (theme.waline.pageview){ %>
<script>
	// 在 CDN 模块加载前计时；Waline 成功会替换转圈图标，超时才显示占位。
	setTimeout(() => {
	  const count = document.querySelector('.waline-pageview-count');
	  if (count && count.querySelector('.fa-spinner')) count.textContent = '—';
	}, 15000);
</script>
<% } %>
<% if (showComments){ %>
<link href='https://unpkg.com/@waline/client@v3/dist/waline.css' rel='stylesheet' />
<!-- 评论与正文使用相同的卡片边界，保留 Waline 自己管理的挂载容器。 -->
<section class="article-comments" aria-labelledby="article-comments-title">
  <header class="article-comments-header">
    <h2 id="article-comments-title">留言</h2>
    <p>欢迎交流想法，也欢迎指出文中的问题。</p>
  </header>
  <div id="waline"></div>
</section>
<% } %>
<script type="module">
	import { init } from 'https://unpkg.com/@waline/client@v3/dist/waline.js';

	// 中文默认
	const locale = {
	  nick: ' 昵称: ',
	  nickError: '昵称不能少于3个字符',
	  mail: '邮箱: ',
	  mailError: '请填写正确的邮件地址',
	  link: '网址: ',
	  placeholder: ' 客官留个言吧(◕ˇ∀ˇ◕)',
	  sofa: '评论区空空荡荡，客官快来评论吧~',
	  submit: '提交',
	  reply: '回复',
	  cancelReply: '取消回复',
	  comment: '评论',
	  more: '加载更多...',
	  preview: '预览',
	  emoji: '表情',
	  uploadImage: '上传图片',
	  seconds: '秒前',
	  minutes: '分钟前',
	  hours: '小时前',
	  days: '天前',
	  now: '刚刚',
	  uploading: '正在上传',
	  login: '登录',
	  logout: '退出',
	  admin: '博主',
	  word: '字',
	  wordHint: '评论字数应在 $0 到 $1 字之间！\n当前字数：$2',
	};

	init({
	  // 只初始化一次；el 为 null 时保留阅读量统计，不创建评论区。
	  el: <%- JSON.stringify(showComments ? '#waline' : null) %>,
	  serverURL: '<%= theme.waline.server_url %>',
	  locale,
	  login: '<%= theme.waline.login %>',
	  lang: '<%= theme.waline.lang %>',
	  dark: '<%= theme.waline.dark %>',
	  // 设置 emoji 为微博与哔哩哔哩
	  emoji: [
		'https://unpkg.com/@waline/emojis@1.1.0/weibo',
		'https://unpkg.com/@waline/emojis@1.1.0/bilibili',
	  ],
	  wordLimit: <%= theme.waline.word_limit %>,
	  pageSize: <%= theme.waline.page_size %>,
	  imageUploader: <%= theme.waline.image_uploader %>,
	  pageview: <%= theme.waline.pageview %>,
	  meta: ['nick', 'mail', 'link'],  //评论者相关属性，默认['nick', 'mail', 'link'],
	  requiredMeta: ['nick'], //设置评论者属性必填项，默认[]（即匿名）
	});
</script>
